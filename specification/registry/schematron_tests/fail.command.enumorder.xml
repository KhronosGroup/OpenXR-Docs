<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xml>
<registry>
    <comment>
Copyright (c) 2017-2026 The Khronos Group Inc.

SPDX-License-Identifier: Apache-2.0 OR MIT
    </comment>

    <enums name="XrResult" type="enum" comment="Error and return codes">
        <!-- Return codes for successful operation execution (positive values) -->
        <enum value="0"    name="XR_SUCCESS"                    comment="Function successfully completed."/>
        <!-- Error codes (negative values) -->
        <enum value="-1"   name="XR_ERROR_FUNCTION_UNSUPPORTED" comment="The function is not supported."/>
        <enum value="-2"   name="XR_ERROR_VALIDATION_FAILURE"   comment="The function usage was invalid in some way."/>
    </enums>

    <types>
        <type name="openxr_platform_defines" category="include">#include "openxr_platform_defines.h"</type>
        <type requires="openxr_platform_defines" name="void"/>
        <type requires="openxr_platform_defines" name="char"/>

        <type category="define">
#if !defined(XR_DEFINE_HANDLE)
#if (XR_PTR_SIZE == 8)
    #define <name>XR_DEFINE_HANDLE</name>(object) typedef struct object##_T* object;
#else
    #define XR_DEFINE_HANDLE(object) typedef uint64_t object;
#endif
#endif
        </type>

        <type category="handle"><type>XR_DEFINE_HANDLE</type>(<name>XrInstance</name>)</type>

        <type name="XrResult" category="enum"/>
    </types>

    <commands>
        <!-- XR_ERROR_VALIDATION_FAILURE before XR_ERROR_FUNCTION_UNSUPPORTED violates alphabetical order -->
        <command successcodes="XR_SUCCESS" errorcodes="XR_ERROR_VALIDATION_FAILURE,XR_ERROR_FUNCTION_UNSUPPORTED">
            <proto><type>XrResult</type> <name>xrSampleCommand</name></proto>
            <param><type>XrInstance</type> <name>instance</name></param>
            <param><type>char</type> <name>charValue</name></param>
        </command>
    </commands>

    <feature api="openxr" name="XR_VERSION_1_0" number="1.0">
        <require comment="Header boilerplate">
            <type name="openxr_platform_defines"/>
        </require>
        <require>
            <command name="xrSampleCommand"/>
        </require>
        <require comment="Types and commands defined by this test fixture">
            <type name="XR_DEFINE_HANDLE"/>
            <type name="XrInstance"/>
            <type name="XrResult"/>
        </require>
    </feature>
</registry>
